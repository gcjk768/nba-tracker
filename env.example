# Copy to .env on the NAS and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=            # from BotFather
TELEGRAM_CHAT_ID=              # the group, e.g. -100...
TELEGRAM_THREAD_ID=            # the "NBA" topic's message_thread_id
ALLOWED_USER_IDS=              # comma-separated Telegram user ids allowed to run commands
ANTHROPIC_API_KEY=             # prepaid key for claude -p (copy from another NAS app's .env)
CLAUDE_FALLBACK_OAUTH_TOKEN=   # optional: /fb wrapper falls back to the subscription on credit errors
CLAUDE_MODEL_DAILY=claude-sonnet-5-5
CLAUDE_MODEL_ASK=claude-haiku-5-5
SPOILER_MODE=on                # off = no <tg-spoiler> tags anywhere
ASK_DAILY_LIMIT=20             # /ask + /whatif per day, combined
FILM_VERIFY=on                 # off = film room labels are stored without the second (verifier) Haiku call
BREAKDOWN_MAX=30                # team-games the analysts break down per run (4 claude calls each)
PLAYBOOK_NOTES_MAX=10            # teams the playbook analyst reads per run (1 claude call each)
